{
  "name": "xmas-present-delivery",
  "description": "An interactive Christmas card: one year to rebuild Father Christmas's operation.",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "wrangler deploy",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "og": "node scripts/og-image.mjs",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build && wrangler dev",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "test": "esbuild src/game/acceptance.test.ts --bundle --format=cjs --platform=node --outfile=.scratch/acc.cjs --log-level=warning && node .scratch/acc.cjs",
    "db.create": "wrangler d1 create xmas-present-delivery",
    "db.migrate.local": "wrangler d1 migrations apply xmas-present-delivery --local",
    "db.migrate": "wrangler d1 migrations apply xmas-present-delivery --remote"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.4.1",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "^1.20.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.4.5",
    "typescript-eslint": "8.69.0",
    "typescript-plugin-css-modules": "latest",
    "undici": "*",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  }
}
